<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #ccffcc;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="education.learning.system.BookShopLoginPageController">
   <children>
      <Label fx:id="txt1" layoutX="179.0" layoutY="42.0" text="Online Book Shop">
         <font>
            <Font name="Book Antiqua Italic" size="38.0" />
         </font>
      </Label>
      <Button layoutX="168.0" layoutY="138.0" mnemonicParsing="false" onAction="#userBtn" prefHeight="30.0" prefWidth="264.0" style="-fx-background-radius: 10; -fx-background-color: #89CFF0;" text="User">
         <font>
            <Font name="Arial Rounded MT Bold" size="21.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button fx:id="adminBtn" layoutX="168.0" layoutY="200.0" mnemonicParsing="false" onAction="#adminBtn" prefHeight="42.0" prefWidth="264.0" style="-fx-background-radius: 10; -fx-background-color: #6495ED;" text="Admin">
         <font>
            <Font name="Arial Rounded MT Bold" size="21.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="69.0" layoutY="326.0" mnemonicParsing="false" onAction="#backBtn" style="-fx-background-radius: 5; -fx-background-color: #F0FFFF;" text="Back">
         <font>
            <Font name="Maiandra GD" size="12.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="512.0" layoutY="326.0" mnemonicParsing="false" onAction="#exitBtn" style="-fx-background-radius: 5; -fx-background-color: #FF0000;" text="Exit">
         <font>
            <Font name="Bauhaus 93" size="12.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button fx:id="bookReviews" layoutX="172.0" layoutY="268.0" mnemonicParsing="false" onAction="#bookReview" prefHeight="42.0" prefWidth="254.0" style="-fx-background-radius: 10; -fx-background-color: #89CFF0;" text="Read Book Review ">
         <font>
            <Font name="Arial Rounded MT Bold" size="21.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</AnchorPane>
